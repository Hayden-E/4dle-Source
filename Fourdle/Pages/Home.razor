@page "/"
@inject GuessService GuessService
@inject StorageService StorageService
@inject IJSRuntime JSRuntime
@using System.Timers;

<PageTitle>Play - 4dle</PageTitle>
<h1 class="title">4dle</h1>
<p>4 Letters 4 Attempts</p>

@* <div class="overlay">
	<p>Today's Free Attempt:</p>
	<GuessComponent Input="@TodaysGuess"></GuessComponent>
</div> *@

<div class="game-container"> 
	
	@for (int i = 0; i < AllowedGuesses; i++)
	{
		if (CurrentGuesses.Count > i)
		{
			<div class="game-column">
				<GuessComponent Input="@CurrentGuesses[i]"></GuessComponent>
			</div>
		}
		else
		{
			<div class="game-column">
				<GuessComponent Input=""></GuessComponent>
			</div>
		}
	}

	@if(LocalStreak != 0)
	{
		<p>Current Streak: @LocalStreak 🔥</p>
	}
	
</div>

@if(LastWasInvalid)
{
	<div class="invalid-title">
		<p>Invalid Word</p>
	</div>
}

@if(HasWon)
{
	<div class="input-area">
		<p>You Win! <br /> New word in @CountdownTimer</p>
		<button @onclick="CopyResults">Copy Results!</button>
	</div>
}
else if (CurrentGuesses.Count >= AllowedGuesses)
{
	<div class="input-area">
		<p>You Lose... The word was '@TodaysWord' <br /> New word in @CountdownTimer</p>
		<button @onclick="CopyResults">Copy Results!</button>
	</div>
}
else
{
	<div class="input-area">
		<input @onkeydown="HandleSubmitKeyDown" @bind="CurrentInput" @bind:event="oninput" placeholder="Type answer..." type="text" maxlength="4" />

		<button @onclick="AddGuess">Guess</button>
	</div>

	<div class="free-attempt">
		<p>Today's Free Attempt:</p>
		<GuessComponent Input="@TodaysGuess"></GuessComponent>
	</div>
}

@code 
{
	private Timer tickTimer;

	public int AllowedGuesses = 4;
	public bool HasWon = false;
	public bool LastWasInvalid = false;

	public string? TodaysWord;
	public string? TodaysGuess;
	public string? CurrentInput;
	List<string> CurrentGuesses = new List<string>();

	public string CountdownTimer = "";

	public int LocalStreak = 0;

	public async void CheckForWin()
	{
		await StorageService.SaveGuesses(CurrentGuesses.ToArray());

		if (CurrentGuesses.Count <= 0)
			return;

		HasWon = await GuessService.CheckWin(GuessService.DefaultSeed(), CurrentGuesses[CurrentGuesses.Count - 1]);

		if (HasWon)
			await OnWon();
		else if (CurrentGuesses.Count >= AllowedGuesses)
			await StorageService.ResetStreak();
	}

	public void AddGuess()
	{
		if (string.IsNullOrEmpty(CurrentInput))
			return;

		if (CurrentInput.Length != 4)
			return;

		if (!GuessService.ValidWord(CurrentInput))
		{
			LastWasInvalid = true;
			return;
		}

		LastWasInvalid = false;

		CurrentGuesses.Add(CurrentInput.ToUpper());
		CurrentInput = "";
		CheckForWin();
	}

	private void HandleSubmitKeyDown(KeyboardEventArgs e)
	{
		if (e.Key == "Enter")
		{
			AddGuess();
		}
	}

	protected override async Task OnInitializedAsync()
	{
		TodaysWord = await GuessService.GetWordForSeed(GuessService.DefaultSeed());
		TodaysGuess = await TodaysAttempt();

		string[] guesses = await StorageService.TodaysGuesses();

		CurrentGuesses.Clear();
		CurrentGuesses.AddRange(guesses);

		if (CurrentGuesses.Count > 0)
		{
			HasWon = await GuessService.CheckWin(
				GuessService.DefaultSeed(),
				CurrentGuesses[^1]
			);
		}

		LocalStreak = await StorageService.GetCurrentStreak();

		tickTimer = new Timer(1000);
		tickTimer.Elapsed += (sender, e) => InvokeAsync(UpdateTimer);
		tickTimer.AutoReset = true;
		tickTimer.Enabled = true;
	}

	public void UpdateTimer()
	{
		CountdownTimer = (DateTime.Now - DateTime.Now.Date.AddDays(1)).ToString(@"hh\:mm\:ss");
		StateHasChanged();
	}

	private async Task<string> TodaysAttempt()
	{
		string todaysWord = await GuessService.GetWordForSeed(GuessService.DefaultSeed());
		string word = await GuessService.GetWordWith(1, 0, todaysWord);

		return word;
	}

	private async void CopyResults()
	{
		string todaysWord = await GuessService.GetWordForSeed(GuessService.DefaultSeed());

		StringBuilder builder = new StringBuilder();

		if(HasWon)
			builder.AppendLine($"4dle {DaysSinceStart()} {CurrentGuesses.Count}/4");
		else
			builder.AppendLine($"4dle {DaysSinceStart()} X/4");

		if (LocalStreak != 0)
			builder.AppendLine($"Current Streak: {LocalStreak} 🔥");

		builder.AppendLine();

		for(int i = 0; i < CurrentGuesses.Count; i++)
		{
			int[] results = GuessService.GetGuessResultForWord(todaysWord, CurrentGuesses[i]);

			for(int j = 0; j < results.Length; j++)
			{
				if (results[j] == 0)
					builder.Append("⬜");
				else if (results[j] == 1)
					builder.Append("🟨");
				else if (results[j] == 2)
					builder.Append("🟩");
			}

			builder.AppendLine();
		}

		builder.Append("https://hayden-e.github.io/4dle/");

		await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", builder.ToString());
	}

	private int DaysSinceStart()
	{
		return (DateTime.Now - new DateTime(2026, 7, 29)).Days;
	}

	public async Task OnWon()
	{
		await StorageService.AddToStreak();
	}
}